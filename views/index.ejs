<!DOCTYPE html>
<html>
    <head>
        <title>My Page</title>

        <style>
            .container {
                display: flex;
                flex-direction: row;
            }

            iframe {
                flex-basis: 50%;
                height: 500px;
                border: 1px solid black;
            }

            .container {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-around;
            }

            iframe {
                flex-basis: calc(50% - 20px);
                height: 600px;
                margin-bottom: 20px;
            }
        </style>
    </head>
    <body>
        <h1>My Page</h1>
        <form action="/logout" method="POST">
            <!-- Your form fields here -->
            <button type="submit">Logout</button>
        </form>    
        <div class="container">
            <iframe src="/myGallery"></iframe>
            <iframe src="./contributions"></iframe>
        </div>
    </body>
</html>
